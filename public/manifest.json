{
  "manifest_version": 3,
  "name": "CopyLens",
  "version": "1.4.0",
  "description": "Select visible webpage text and copy it with local OCR.",
  "author": "CopyLens",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CopyLens",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ocr/*",
        "ocr/**/*",
        "ocr/langdata/*",
        "assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
